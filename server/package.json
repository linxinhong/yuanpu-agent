{
  "name": "@yuanpu-agent/catalog-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsx watch src/index.ts --port 8787",
    "start": "node dist/index.mjs --port 8787",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@yuanpu-agent/protocol": "workspace:*"
  }
}
