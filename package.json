{
  "name": "@yuanpu-agent/monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "build:app": "pnpm --filter @yuanpu-agent/app... run build",
    "build:desktop": "pnpm --filter @yuanpu-agent/desktop... run build",
    "build:runtime": "pnpm --filter @yuanpu-agent/runtime... run build",
    "build:native": "pnpm --filter @yuanpu-agent/runtime run build:native",
    "check": "pnpm run typecheck && pnpm run build && pnpm run test",
    "dev": "pnpm build:runtime && pnpm build:desktop && pnpm --filter @yuanpu-agent/desktop run dev",
    "package:desktop": "pnpm run build && pnpm run build:native && pnpm --filter @yuanpu-agent/desktop run package",
    "package:native": "pnpm --filter @yuanpu-agent/runtime run package:native",
    "release:manifest": "pnpm --filter @yuanpu-agent/runtime run release:manifest",
    "smoke:native": "pnpm --filter @yuanpu-agent/runtime run smoke:native",
    "start": "pnpm run dev",
    "test": "pnpm -r --if-present run test",
    "typecheck": "pnpm -r run typecheck"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.22.0",
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsdown": "0.23.0",
    "typescript": "6.0.2"
  }
}
